#!/bin/bash
echo "Downloading the Arduino-CLI. A network connection is needed!"
#Arduino CLi
#curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | BINDIR=/usr/bin sh

/usr/bin/arduino-cli board list
/usr/bin/arduino-cli core install arduino:avr

#Default Libraries

/usr/bin/chonosFirmwareManager --removeLibrary HCSR04
/usr/bin/chonosFirmwareManager --importLibrary -f /opt/group.chon/lib/arduino-libraries/javino2arduino-javino-oldstable.zip
/usr/bin/chonosFirmwareManager --importLibrary -f /opt/group.chon/lib/arduino-libraries/HCSR04-ultrasonic-sensor-lib-2.0.2.zip
/usr/bin/chonosFirmwareManager --importLibrary -f /opt/group.chon/lib/arduino-libraries/LiquidCrystal-1.0.7.zip